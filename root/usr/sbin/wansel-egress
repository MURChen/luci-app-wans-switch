#!/bin/sh
# wansel-egress - 按域名/IP 指定出口与协议族（IPv4 / IPv6）
#
# 用法:
#   wansel-egress list                                           列出规则（JSON）
#   wansel-egress add <domain|ip> <value> <default|wan|usb> [family] [group]
#   wansel-egress edit <old> <type> <value> <via> <family> <group>  编辑单条规则
#   wansel-egress del <value>                                    删除规则
#   wansel-egress apply [dns]                                    应用（dns=同时重启 dnsmasq）
#   wansel-egress status                                         状态（JSON）
#   wansel-egress connections [all|wan|usb|default|matched] [nodns,nolan]
#   wansel-egress flush [stale|all]                              清理旧连接
#   wansel-egress hook on|off                                    OpenClash hook 开关
#   wansel-egress preset list                                   列出内置预设
#   wansel-egress preset apply <name> <via> [family] [group]    应用内置预设
#   wansel-egress fetch <url>                                    下载并预览规则（JSON）
#   wansel-egress import <url> <via> [family] [group]           下载并导入规则
#   wansel-egress group list                                    列出规则组
#   wansel-egress group set <group> <via> [family]              按组批量改出口
#   wansel-egress group rename <old> <new>                      重命名组
#   wansel-egress cleanup                                       清理所有策略出口规则
#
# 出口映射:
#   default  跟随默认（main 表，受第一页的出口切换影响）
#   wan      mark 0x100 -> 表 100 -> eth0
#   usb      mark 0x101 -> 表 101 -> usb0
#
# 协议族:
#   both     同时收集 A 和 AAAA
#   ipv4     只收集 A 记录
#   ipv6     只收集 AAAA 记录

. /lib/functions.sh 2>/dev/null

CFG="wansel_egress"
[ -f "/etc/config/$CFG" ] || : > "/etc/config/$CFG"
STATE_DIR="/var/run/wansel-egress"
DNSMASQ_CONF="/etc/dnsmasq.conf"
DNS_MARK_BEGIN="# >>> wansel-egress nftset >>>"
DNS_MARK_END="# <<< wansel-egress nftset <<<"

WAN_SET="wansel_wan_v4"
USB_SET="wansel_usb_v4"
WAN_SET6="wansel_wan_v6"
USB_SET6="wansel_usb_v6"
WAN_MARK="0x100"
USB_MARK="0x101"
WAN_TABLE="100"
USB_TABLE="101"
WAN_PREF="1000"

# ---------- 接口解析 ----------
wan_dev() { echo "eth0"; }

usb_dev() {
	local d
	d=$(uci -q get network.tethering.device)
	[ -n "$d" ] || d=$(uci -q get network.tethering.ifname)
	[ -n "$d" ] || d="usb0"
	echo "$d"
}

gw_v4() {
	ip -4 route show default dev "$1" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}' | head -n1
}

gw_v6() {
	ip -6 route show default dev "$1" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}' | head -n1
}

# ---------- 规则读写 ----------
list_rules_json() {
	local first=1
	echo -n '{"rules":['
	config_load "$CFG"
	config_foreach _emit_rule rule
	echo -n ']}'
}

_emit_rule() {
	local section="$1" type value via family group
	config_get type "$section" "type" ""
	config_get value "$section" "value" ""
	config_get via "$section" "via" "default"
	config_get family "$section" "family" "both"
	config_get group "$section" "group" ""
	[ -n "$value" ] || return 0
	[ "$first" = "1" ] || echo -n ','
	first=0
	printf '{"id":"%s","type":"%s","value":"%s","via":"%s","family":"%s","group":"%s"}' \
		"$section" "$type" "$value" "$via" "$family" "$group"
}

rule_add() {
	local type="$1" value="$2" via="$3" family="${4:-both}" group="${5:-}"
	[ -n "$type" ] && [ -n "$value" ] || { echo "参数不足"; return 1; }
	case "$via" in
		default|wan|usb) ;;
		*) echo "出口必须是 default/wan/usb"; return 1 ;;
	esac
	case "$family" in
		both|ipv4|ipv6) ;;
		*) family="both" ;;
	esac
	local dup_match=""
	config_load "$CFG"
	_dup_check() {
		local s="$1" t v
		config_get t "$s" "type" ""
		config_get v "$s" "value" ""
		[ "$t" = "$type" ] && [ "$v" = "$value" ] && dup_match="$s"
	}
	config_foreach _dup_check rule
	if [ -n "$dup_match" ]; then
		uci set "$CFG.$dup_match.via=$via"
		uci set "$CFG.$dup_match.family=$family"
		[ -n "$group" ] && uci set "$CFG.$dup_match.group=$group"
		uci commit "$CFG"
		echo "已更新: $value -> $via ($family)"
		return 0
	fi
	local section
	section="rule_$(echo "$value" | tr -c 'a-zA-Z0-9' '_')"
	uci set "$CFG.$section=rule"
	uci set "$CFG.$section.type=$type"
	uci set "$CFG.$section.value=$value"
	uci set "$CFG.$section.via=$via"
	uci set "$CFG.$section.family=$family"
	[ -n "$group" ] && uci set "$CFG.$section.group=$group"
	uci commit "$CFG"
	echo "已添加: $value -> $via ($family)${group:+ [$group]}"
}

# 编辑单条规则: 按原 value 定位
rule_edit() {
	local oldval="$1" newtype="$2" newvalue="$3" newvia="$4" newfamily="$5" newgroup="$6"
	[ -n "$oldval" ] || { echo "缺少原值"; return 1; }
	local found=""
	config_load "$CFG"
	_edit_check() {
		local s="$1" v
		config_get v "$s" "value" ""
		[ "$v" = "$oldval" ] && found="$s"
	}
	config_foreach _edit_check rule
	if [ -z "$found" ]; then
		echo "未找到规则: $oldval"
		return 1
	fi
	case "$newvia" in
		default|wan|usb) ;;
		*) newvia="default" ;;
	esac
	case "$newfamily" in
		both|ipv4|ipv6) ;;
		*) newfamily="both" ;;
	esac
	case "$newtype" in
		domain|ip) ;;
		*) newtype="domain" ;;
	esac
	[ -n "$newvalue" ] || newvalue="$oldval"

	# 值没变：原地更新
	if [ "$newvalue" = "$oldval" ]; then
		uci set "$CFG.$found.type=$newtype"
		uci set "$CFG.$found.value=$newvalue"
		uci set "$CFG.$found.via=$newvia"
		uci set "$CFG.$found.family=$newfamily"
		if [ -n "$newgroup" ]; then
			uci set "$CFG.$found.group=$newgroup"
		else
			uci -q delete "$CFG.$found.group"
		fi
		uci commit "$CFG"
		echo "已保存: $newvalue -> $newvia ($newfamily)${newgroup:+ [$newgroup]}"
		return 0
	fi

	# 值变了：重建 section，避免旧名残留
	local newsection
	newsection="rule_$(echo "$newvalue" | tr -c 'a-zA-Z0-9' '_')"
	if [ "$newsection" != "$found" ] && uci -q get "$CFG.$newsection" >/dev/null 2>&1; then
		echo "规则已存在: $newvalue"
		return 1
	fi
	uci set "$CFG.$newsection=rule"
	uci set "$CFG.$newsection.type=$newtype"
	uci set "$CFG.$newsection.value=$newvalue"
	uci set "$CFG.$newsection.via=$newvia"
	uci set "$CFG.$newsection.family=$newfamily"
	if [ -n "$newgroup" ]; then
		uci set "$CFG.$newsection.group=$newgroup"
	fi
	[ "$newsection" != "$found" ] && uci -q delete "$CFG.$found"
	uci commit "$CFG"
	echo "已保存: $newvalue -> $newvia ($newfamily)${newgroup:+ [$newgroup]}"
}


# 组列表: 返回 group -> via/family 汇总
group_list_json() {
	local first=1
	echo -n '{"groups":['
	config_load "$CFG"
	_g_emit() {
		local s="$1" group via family
		config_get group "$s" "group" ""
		config_get via "$s" "via" "default"
		config_get family "$s" "family" "both"
		[ -n "$group" ] || return 0
		# 首次遇到某个组才输出
		case " $seen " in *" $group "*) return 0 ;; esac
		seen="$seen $group"
		[ "$gfirst" = "1" ] || echo -n ','
		gfirst=0
		printf '{"name":"%s","via":"%s","family":"%s"}' "$group" "$via" "$family"
	}
	seen=""; gfirst=1
	config_foreach _g_emit rule
	echo -n ']}'
}

# 按组批量修改出口/协议
group_set() {
	local group="$1" via="$2" family="${3:-}"
	[ -n "$group" ] || { echo "缺少组名"; return 1; }
	case "$via" in
		default|wan|usb) ;;
		*) echo "出口必须是 default/wan/usb"; return 1 ;;
	esac
	local n=0
	config_load "$CFG"
	_gs_apply() {
		local s="$1" g
		config_get g "$s" "group" ""
		[ "$g" = "$group" ] || return 0
		uci set "$CFG.$s.via=$via"
		[ -n "$family" ] && uci set "$CFG.$s.family=$family"
		n=$((n + 1))
	}
	config_foreach _gs_apply rule
	uci commit "$CFG"
	echo "组 $group: 已更新 $n 条规则 -> $via${family:+ ($family)}"
}

# 重命名组
group_rename() {
	local oldg="$1" newg="$2"
	[ -n "$oldg" ] && [ -n "$newg" ] || { echo "参数不足"; return 1; }
	local n=0
	config_load "$CFG"
	_gr_apply() {
		local s="$1" g
		config_get g "$s" "group" ""
		[ "$g" = "$oldg" ] || return 0
		uci set "$CFG.$s.group=$newg"
		n=$((n + 1))
	}
	config_foreach _gr_apply rule
	uci commit "$CFG"
	echo "已重命名: $oldg -> $newg ($n 条)"
}
rule_del() {
	local target="$1" found=""
	config_load "$CFG"
	_del_check() {
		local s="$1" v
		config_get v "$s" "value" ""
		[ "$v" = "$target" ] && found="$s"
	}
	config_foreach _del_check rule
	if [ -z "$found" ]; then
		echo "未找到规则: $target"
		return 1
	fi
	uci -q delete "$CFG.$found"
	uci commit "$CFG"
	echo "已删除: $target"
}

# ---------- nft ----------
need_fw4_table() { nft list table inet fw4 >/dev/null 2>&1; }

ensure_set() {
	local set="$1" fam="$2"
	nft list set inet fw4 "$set" >/dev/null 2>&1 && return 0
	if [ "$fam" = "v6" ]; then
		nft add set inet fw4 "$set" "{ type ipv6_addr; flags interval; }" 2>/dev/null
	else
		nft add set inet fw4 "$set" "{ type ipv4_addr; flags interval; }" 2>/dev/null
	fi
}

flush_set() { nft flush set inet fw4 "$1" 2>/dev/null; }

add_set_element() {
	nft add element inet fw4 "$1" "{ $2 }" 2>/dev/null
}

set_count() {
	local body
	body=$(nft list set inet fw4 "$1" 2>/dev/null | sed -n 's/.*elements = { *//p' | tr -d '}')
	[ -n "$body" ] || { echo 0; return; }
	echo "$body" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -c .
}

set_elements() {
	nft list set inet fw4 "$1" 2>/dev/null | sed -n 's/.*elements = { *//p' | tr -d '}' | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$' | tr '\n' ' '
}

# ---------- ip rule / 路由表 ----------
ensure_route_v4() {
	[ -n "$2" ] && [ -n "$3" ] || return 1
	ip route replace default via "$2" dev "$3" table "$1" 2>/dev/null
}

ensure_route_v6() {
	local dev="$3"
	[ -n "$dev" ] || return 1
	if [ -n "$2" ]; then
		ip -6 route replace default via "$2" dev "$dev" table "$1" 2>/dev/null
	else
		ip -6 route replace default dev "$dev" table "$1" 2>/dev/null
	fi
}

ensure_rule_v4() {
	local mark="$1" table="$2" pref="$3"
	ip rule show 2>/dev/null | grep -q "fwmark $mark lookup $table" && return 0
	ip rule add fwmark "$mark" table "$table" pref "$pref" 2>/dev/null && return 0
	local p=$((pref + 1))
	while [ $p -lt $((pref + 20)) ]; do
		ip rule add fwmark "$mark" table "$table" pref "$p" 2>/dev/null && return 0
		p=$((p+1))
	done
	return 1
}

ensure_rule_v6() {
	local mark="$1" table="$2" pref="$3"
	ip -6 rule show 2>/dev/null | grep -q "fwmark $mark lookup $table" && return 0
	ip -6 rule add fwmark "$mark" table "$table" pref "$pref" 2>/dev/null && return 0
	local p=$((pref + 1))
	while [ $p -lt $((pref + 20)) ]; do
		ip -6 rule add fwmark "$mark" table "$table" pref "$p" 2>/dev/null && return 0
		p=$((p+1))
	done
	return 1
}

remove_rule_v4() {
	local mark="$1" table="$2" p=980
	while [ $p -lt 1100 ]; do
		ip rule del fwmark "$mark" table "$table" pref "$p" 2>/dev/null
		p=$((p+1))
	done
	ip rule del fwmark "$mark" table "$table" 2>/dev/null
}

remove_rule_v6() {
	local mark="$1" table="$2" p=980
	while [ $p -lt 1100 ]; do
		ip -6 rule del fwmark "$mark" table "$table" pref "$p" 2>/dev/null
		p=$((p+1))
	done
	ip -6 rule del fwmark "$mark" table "$table" 2>/dev/null
}

# ---------- mark 规则 ----------
ensure_mangle_chain() {
	nft list chain inet fw4 mangle_prerouting >/dev/null 2>&1 && return 0
	nft add chain inet fw4 mangle_prerouting '{ type filter hook prerouting priority mangle; policy accept; }' 2>/dev/null
}

rebuild_mark_rules() {
	ensure_mangle_chain
	nft -a list chain inet fw4 mangle_prerouting 2>/dev/null | \
		grep -E "wansel-(wan|usb)-mark" | \
		sed -n 's/.*# handle \([0-9]*\).*/\1/p' | \
		while read -r h; do nft delete rule inet fw4 mangle_prerouting handle "$h" 2>/dev/null; done

	ensure_set "$WAN_SET" v4
	ensure_set "$USB_SET" v4
	ensure_set "$WAN_SET6" v6
	ensure_set "$USB_SET6" v6

	nft add rule inet fw4 mangle_prerouting ip daddr @$WAN_SET meta mark set $WAN_MARK ct mark set $WAN_MARK counter comment "wansel-wan-mark" 2>/dev/null
	nft add rule inet fw4 mangle_prerouting ip daddr @$USB_SET meta mark set $USB_MARK ct mark set $USB_MARK counter comment "wansel-usb-mark" 2>/dev/null
	nft add rule inet fw4 mangle_prerouting ip6 daddr @$WAN_SET6 meta mark set $WAN_MARK ct mark set $WAN_MARK counter comment "wansel-wan-mark-v6" 2>/dev/null
	nft add rule inet fw4 mangle_prerouting ip6 daddr @$USB_SET6 meta mark set $USB_MARK ct mark set $USB_MARK counter comment "wansel-usb-mark-v6" 2>/dev/null
}

# ---------- dnsmasq nftset 生成 ----------
rebuild_dnsmasq_nftset() {
	local tmp="/tmp/wansel-egress.dns.$$"
	awk -v b="$DNS_MARK_BEGIN" -v e="$DNS_MARK_END" '
		$0 == b {skip=1; next}
		$0 == e {skip=0; next}
		!skip {print}
	' "$DNSMASQ_CONF" > "$tmp" 2>/dev/null

	{
		echo "$DNS_MARK_BEGIN"
		config_load "$CFG"
		_gen_dns_line() {
			local s="$1" type value via family
			config_get type "$s" "type" ""
			config_get value "$s" "value" ""
			config_get via "$s" "via" "default"
			config_get family "$s" "family" "both"
			[ "$type" = "domain" ] || return 0
			[ "$via" = "default" ] && return 0


			case "$via" in
				wan)
					[ "$family" != "ipv6" ] && echo "nftset=/$value/4#inet#fw4#$WAN_SET"
					[ "$family" != "ipv4" ] && echo "nftset=/$value/6#inet#fw4#$WAN_SET6"
					;;
				usb)
					[ "$family" != "ipv6" ] && echo "nftset=/$value/4#inet#fw4#$USB_SET"
					[ "$family" != "ipv4" ] && echo "nftset=/$value/6#inet#fw4#$USB_SET6"
					;;
			esac
		}
		config_foreach _gen_dns_line rule
		echo "$DNS_MARK_END"
	} >> "$tmp"

	mv "$tmp" "$DNSMASQ_CONF"
}

# ---------- IP 规则入 set ----------
apply_ip_rules() {
	config_load "$CFG"
	_apply_ip() {
		local s="$1" type value via
		config_get type "$s" "type" ""
		config_get value "$s" "value" ""
		config_get via "$s" "via" "default"
		[ "$type" = "ip" ] || return 0
		[ "$via" = "default" ] && return 0
		if echo "$value" | grep -q ':'; then
			[ "$via" = "wan" ] && add_set_element "$WAN_SET6" "$value"
			[ "$via" = "usb" ] && add_set_element "$USB_SET6" "$value"
		else
			[ "$via" = "wan" ] && add_set_element "$WAN_SET" "$value"
			[ "$via" = "usb" ] && add_set_element "$USB_SET" "$value"
		fi
	}
	config_foreach _apply_ip rule
}

# ---------- apply ----------
do_apply() {
	local with_dns="$1"
	mkdir -p "$STATE_DIR"

	need_fw4_table || { echo "fw4 表不存在，无法应用"; return 1; }

	ensure_set "$WAN_SET" v4
	ensure_set "$USB_SET" v4
	ensure_set "$WAN_SET6" v6
	ensure_set "$USB_SET6" v6
	flush_set "$WAN_SET"
	flush_set "$USB_SET"
	flush_set "$WAN_SET6"
	flush_set "$USB_SET6"

	apply_ip_rules

	local wdev udev wgw4 ugw4 wgw6 ugw6
	wdev=$(wan_dev)
	udev=$(usb_dev)
	wgw4=$(gw_v4 "$wdev")
	ugw4=$(gw_v4 "$udev")
	wgw6=$(gw_v6 "$wdev")
	ugw6=$(gw_v6 "$udev")

	if [ -n "$wgw4" ]; then
		ensure_route_v4 "$WAN_TABLE" "$wgw4" "$wdev"
		ensure_rule_v4 "$WAN_MARK" "$WAN_TABLE" "$WAN_PREF"
	fi
	if [ -n "$ugw4" ]; then
		ensure_route_v4 "$USB_TABLE" "$ugw4" "$udev"
		ensure_rule_v4 "$USB_MARK" "$USB_TABLE" "$USB_PREF"
	fi
	if ip -6 route show default dev "$wdev" 2>/dev/null | grep -q .; then
		ensure_route_v6 "$WAN_TABLE" "$wgw6" "$wdev"
		ensure_rule_v6 "$WAN_MARK" "$WAN_TABLE" "$WAN_PREF"
	fi
	if ip -6 route show default dev "$udev" 2>/dev/null | grep -q .; then
		ensure_route_v6 "$USB_TABLE" "$ugw6" "$udev"
		ensure_rule_v6 "$USB_MARK" "$USB_TABLE" "$USB_PREF"
	fi

	rebuild_mark_rules
	rebuild_dnsmasq_nftset

	if [ "$with_dns" = "dns" ]; then
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
		sleep 2
	fi

	date +%s > "$STATE_DIR/applied"
	echo "已应用规则"
}

# ---------- status ----------
do_status() {
	local wcount ucount wcount6 ucount6 wcounter ucounter applied hook wan_up usb_up v6_on
	wcount=$(set_count "$WAN_SET")
	ucount=$(set_count "$USB_SET")
	wcount6=$(set_count "$WAN_SET6")
	ucount6=$(set_count "$USB_SET6")
	wcounter=$(nft list chain inet fw4 mangle_prerouting 2>/dev/null | grep 'wansel-wan-mark"' | sed -n 's/.*counter packets \([0-9]*\) bytes \([0-9]*\).*/\1 \2/p')
	ucounter=$(nft list chain inet fw4 mangle_prerouting 2>/dev/null | grep 'wansel-usb-mark"' | sed -n 's/.*counter packets \([0-9]*\) bytes \([0-9]*\).*/\1 \2/p')

	applied="0"
	[ -f "$STATE_DIR/applied" ] && applied=$(cat "$STATE_DIR/applied")

	hook="1"
	config_load "$CFG"
	config_get hook global "openclash_hook" "1"

	wan_up="false"
	usb_up="false"
	[ -n "$(gw_v4 "$(wan_dev)")" ] && wan_up="true"
	[ -n "$(gw_v4 "$(usb_dev)")" ] && usb_up="true"

	v6_on="false"
	sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null | grep -q '^0$' && v6_on="true"

	printf '{"applied":%s,"openclash_hook":%s,"wan_up":%s,"usb_up":%s,"ipv6_enabled":%s,"wan_count":%s,"usb_count":%s,"wan_count6":%s,"usb_count6":%s,"wan_counter":"%s","usb_counter":"%s"}\n' \
		"$applied" "$hook" "$wan_up" "$usb_up" "$v6_on" "${wcount:-0}" "${ucount:-0}" "${wcount6:-0}" "${ucount6:-0}" "${wcounter:-0 0}" "${ucounter:-0 0}"
}

# ---------- connections ----------
do_connections() {
	local filter="$1" flags="$2" wan_ips usb_ips
	wan_ips="$(set_elements "$WAN_SET") $(set_elements "$WAN_SET6")"
	usb_ips="$(set_elements "$USB_SET") $(set_elements "$USB_SET6")"

	conntrack -L 2>/dev/null | awk -v filter="$filter" -v wan_ips="$wan_ips" -v usb_ips="$usb_ips" -v flags="$flags" '
		function is_priv(ip) {
			if (ip ~ /^10\./) return 1
			if (ip ~ /^192\.168\./) return 1
			if (ip ~ /^172\.(1[6-9]|2[0-9]|3[01])\./) return 1
			if (ip ~ /^127\./) return 1
			if (ip ~ /^fe80:/) return 1
			if (ip ~ /^f[cd][0-9a-f][0-9a-f]:/) return 1
			if (ip == "::1") return 1
			return 0
		}
		/^(tcp|udp)/ {
			mark="0"; bytes=0; src=""; dst=""; dport=""
			for (i = 1; i <= NF; i++) {
				if ($i ~ /^mark=/) { split($i, a, "="); mark = a[2] }
				if ($i ~ /^bytes=/ && bytes == 0) { split($i, b, "="); bytes = b[2] }
				if (src == "" && $i ~ /^src=/) { split($i, s, "="); src = s[2] }
				if (dst == "" && $i ~ /^dst=/) { split($i, d, "="); dst = d[2] }
				if (dport == "" && $i ~ /^dport=/) { split($i, p, "="); dport = p[2] }
			}
			# 过滤 DNS 查询
			if (flags ~ /nodns/ && dport == "53") next
			# 过滤内网互访
			if (flags ~ /nolan/ && is_priv(src) && is_priv(dst)) next
			out = "default"
			if (mark == "256" || mark == "0x100") out = "wan"
			else if (mark == "257" || mark == "0x101") out = "usb"
			else if (wan_ips != "" && index(" " wan_ips " ", " " dst " ")) out = "wan"
			else if (usb_ips != "" && index(" " usb_ips " ", " " dst " ")) out = "usb"
			if (filter == "matched") { if (out == "default") next }
			else if (filter != "all" && filter != "" && out != filter) next
			printf "%s|%s|%s|%s|%s|%s\n", $1, src, dst, dport, bytes, out
		}
	' | head -200
}

# ---------- hook ----------
do_hook() {
	local mode="$1"
	local hook_script="/etc/openclash/custom/openclash_custom_firewall_rules.sh"
	local marker="# wansel-egress hook"
	case "$mode" in
		on)
			if [ ! -f "$hook_script" ]; then
				echo "未找到 OpenClash hook 脚本"
				return 1
			fi
			if ! grep -q "$marker" "$hook_script"; then
				awk -v m="$marker" '
					/^[[:space:]]*exit 0[[:space:]]*$/ && !done {
						print ""
						print m
						print "(sleep 8; /usr/sbin/wansel-egress apply) &"
						print "# /wansel-egress hook"
						done = 1
					}
					{ print }
				' "$hook_script" > "/tmp/och_on.$$" && mv "/tmp/och_on.$$" "$hook_script"
				chmod +x "$hook_script"
			fi
			uci set "$CFG.global=egress"
			uci set "$CFG.global.openclash_hook=1"
			uci commit "$CFG"
			echo "OpenClash hook 已启用"
			;;
		off)
			if [ -f "$hook_script" ]; then
				awk -v m="$marker" '
					$0 == m {skip=1; next}
					$0 == "# /wansel-egress hook" {skip=0; next}
					!skip {print}
				' "$hook_script" > "/tmp/och.$$" && mv "/tmp/och.$$" "$hook_script"
				chmod +x "$hook_script"
			fi
			uci set "$CFG.global=egress"
			uci set "$CFG.global.openclash_hook=0"
			uci commit "$CFG"
			echo "OpenClash hook 已禁用"
			;;
		*)
			echo "用法: wansel-egress hook on|off"
			return 1
			;;
	esac
}

# ---------- cleanup ----------
# 清理旧连接（非 ESTABLISHED 状态）
do_flush_stale() {
	local mode="${1:-stale}"
	local n=0
	if ! command -v conntrack >/dev/null 2>&1; then
		echo "未安装 conntrack"
		return 1
	fi
	if [ "$mode" = "all" ]; then
		n=$(conntrack -L 2>/dev/null | grep -c .)
		conntrack -F >/dev/null 2>&1
		echo "已清空全部连接跟踪（$n 条）"
		return 0
	fi
	local st
	for st in TIME_WAIT CLOSE CLOSE_WAIT FIN_WAIT LAST_ACK SYN_SENT; do
		local c
		c=$(conntrack -L -p tcp --state "$st" 2>/dev/null | grep -c .)
		[ "${c:-0}" -gt 0 ] && conntrack -D -p tcp --state "$st" >/dev/null 2>&1
		n=$((n + ${c:-0}))
	done
	echo "已清理旧连接 $n 条（TIME_WAIT / CLOSE / CLOSE_WAIT / FIN_WAIT / LAST_ACK / SYN_SENT）"
}

do_cleanup() {
	flush_set "$WAN_SET"
	flush_set "$USB_SET"
	flush_set "$WAN_SET6"
	flush_set "$USB_SET6"
	remove_rule_v4 "$WAN_MARK" "$WAN_TABLE"
	remove_rule_v4 "$USB_MARK" "$USB_TABLE"
	remove_rule_v6 "$WAN_MARK" "$WAN_TABLE"
	remove_rule_v6 "$USB_MARK" "$USB_TABLE"
	nft -a list chain inet fw4 mangle_prerouting 2>/dev/null | \
		grep -E "wansel-(wan|usb)-mark" | \
		sed -n 's/.*# handle \([0-9]*\).*/\1/p' | \
		while read -r h; do nft delete rule inet fw4 mangle_prerouting handle "$h" 2>/dev/null; done
	ip route flush table "$WAN_TABLE" 2>/dev/null
	ip route flush table "$USB_TABLE" 2>/dev/null
	ip -6 route flush table "$WAN_TABLE" 2>/dev/null
	ip -6 route flush table "$USB_TABLE" 2>/dev/null
	echo "已清理"
}

# ---------- 内置预设 ----------
preset_list_json() {
	echo -n '{"presets":['
	echo -n '{"id":"netease","name":"网易云音乐","count":7}'
	echo -n ']}'
}

do_preset() {
	local name="$1" via="$2" family="${3:-both}" group="${4:-}"
	[ -n "$via" ] || via="wan"
	case "$via" in
		default|wan|usb) ;;
		*) via="wan" ;;
	esac
	case "$family" in
		both|ipv4|ipv6) ;;
		*) family="both" ;;
	esac

	local added=0
	case "$name" in
		netease)
			for d in music.126.net music.163.com interface.music.163.com \
				ipv4.music.163.com 163yun.com api.iplay.163.com \
				music.163.com.163jiasu.com; do
				rule_add domain "$d" "$via" "$family" "$group" >/dev/null
				added=$((added + 1))
			done
			echo "已填充网易云音乐规则: $added 条 -> $via ($family)"
			;;
		*)
			echo "未知预设: $name"
			return 1
			;;
	esac
}

# ---------- URL 规则拉取 ----------
_fetch_file() {
	local url="$1" tmp="$2"
	case "$url" in
		http://*|https://*) ;;
		*) return 1 ;;
	esac
	rm -f "$tmp"
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -qO "$tmp" -T 20 "$url" >/dev/null 2>&1
	elif command -v wget >/dev/null 2>&1; then
		wget -qO "$tmp" -T 20 "$url" >/dev/null 2>&1
	elif command -v curl >/dev/null 2>&1; then
		curl -fsSL -m 20 -o "$tmp" "$url" >/dev/null 2>&1
	else
		return 2
	fi
	[ -s "$tmp" ] || return 3
	local sz
	sz=$(wc -c < "$tmp" 2>/dev/null)
	[ "${sz:-0}" -gt 262144 ] && { rm -f "$tmp"; return 4; }
	return 0
}

_parse_rules() {
	awk '
		{
			line = $0
			gsub(/\r/, "", line)
			gsub(/^[ \t]+/, "", line)
			gsub(/[ \t]+$/, "", line)
			if (line == "") next
			if (line ~ /^#/) next
			if (line ~ /^!/) next
			if (line ~ /^DOMAIN-SUFFIX,/) { split(line, a, ","); print "domain|" a[2]; next }
			if (line ~ /^DOMAIN,/)        { split(line, a, ","); print "domain|" a[2]; next }
			if (line ~ /^IP-CIDR6,/)      { split(line, a, ","); print "ip|" a[2]; next }
			if (line ~ /^IP-CIDR,/)       { split(line, a, ","); print "ip|" a[2]; next }
			if (line ~ /^domain[ \t]/)    { sub(/^domain[ \t]+/, "", line); print "domain|" line; next }
			if (line ~ /^ip[ \t]/)        { sub(/^ip[ \t]+/, "", line); print "ip|" line; next }
			if (line ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/ || line ~ /:/) { print "ip|" line; next }
			if (line ~ /\./) { print "domain|" line; next }
		}
	' "$1" | head -200
}

do_fetch() {
	local url="$1" tmp="/tmp/wansel-fetch.$$"
	if ! _fetch_file "$url" "$tmp"; then
		echo '{"ok":false,"error":"下载失败，请检查 URL 或网络"}'
		rm -f "$tmp"
		return 1
	fi
	local count
	count=$(_parse_rules "$tmp" | grep -c .)
	if [ "$count" -eq 0 ]; then
		rm -f "$tmp"
		echo '{"ok":false,"error":"没有解析到规则"}'
		return 1
	fi
	echo -n '{"ok":true,"count":'
	echo -n "$count"
	echo -n ',"items":['
	local first=1 t v
	_parse_rules "$tmp" > "/tmp/wansel-items.$$"
	while IFS='|' read -r t v; do
		[ -n "$v" ] || continue
		[ "$first" = "1" ] || echo -n ','
		first=0
		printf '{"type":"%s","value":"%s"}' "$t" "$v"
	done < "/tmp/wansel-items.$$"
	echo -n ']}'
	rm -f "$tmp" "/tmp/wansel-items.$$"
}

do_import_url() {
	local url="$1" via="${2:-wan}" family="${3:-both}" group="${4:-}"
	local tmp="/tmp/wansel-import.$$"
	if ! _fetch_file "$url" "$tmp"; then
		echo "下载失败，请检查 URL 或网络"
		rm -f "$tmp"
		return 1
	fi
	local n=0 t v
	_parse_rules "$tmp" > "/tmp/wansel-items.$$"
	while IFS='|' read -r t v; do
		[ -n "$v" ] || continue
		rule_add "$t" "$v" "$via" "$family" "$group" >/dev/null
		n=$((n + 1))
	done < "/tmp/wansel-items.$$"
	rm -f "$tmp" "/tmp/wansel-items.$$"
	echo "已从 URL 导入 $n 条规则 -> $via ($family)"
}

case "$1" in
	list)        list_rules_json; echo ;;
	add)         shift; rule_add "$@" ;;
	del)         shift; rule_del "$@" ;;
	apply)       shift; do_apply "$1" ;;
	status)      do_status ;;
	connections) shift; do_connections "${1:-all}" "$2" ;;
	hook)        shift; do_hook "$1" ;;
	edit)        shift; rule_edit "$@" ;;
	group)       shift; case "$1" in list) group_list_json; echo ;; set) shift; group_set "$@" ;; rename) shift; group_rename "$@" ;; *) echo "用法: wansel-egress group list|set <group> <via> [family]|rename <old> <new>"; exit 1 ;; esac ;;
	preset)      shift; case "$1" in list) preset_list_json; echo ;; apply) shift; do_preset "$@" ;; *) echo "用法: wansel-egress preset list|apply <name> <via> [family]"; exit 1 ;; esac ;;
	fetch)       shift; do_fetch "$1" ;;
	import)      shift; do_import_url "$@" ;;
	flush)       shift; do_flush_stale "$1" ;;
	cleanup)     do_cleanup ;;
	*) echo "用法: wansel-egress {list|add|del|apply|status|connections|hook|cleanup}"; exit 1 ;;
esac
