#!/bin/sh /etc/rc.common
# wansel - 出口切换守护服务

START=99
STOP=10
USE_PROCD=1

start_service() {
	# 重启后回到默认出口（宽带）
	[ -f /tmp/wansel/active ] || printf 'wan' > /tmp/wansel/active

	procd_open_instance
	procd_set_param command /usr/sbin/wansel-daemon
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
