#!/bin/sh /etc/rc.common
# wansel-switchd - 物理拨动开关监听服务

START=99
STOP=10
USE_PROCD=1

start_service() {
	# 非 GL.iNet 固件直接跳过
	[ -f /lib/functions/gl_util.sh ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/wansel-switchd
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
