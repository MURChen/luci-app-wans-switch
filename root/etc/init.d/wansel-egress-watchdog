#!/bin/sh /etc/rc.common
# wansel-egress-watchdog: 守护策略出口规则

START=99
STOP=10

USE_PROCD=1
PROG=/usr/sbin/wansel-egress-watchdog

start_service() {
	[ -x "$PROG" ] || return 0
	procd_open_instance
	procd_set_param command "$PROG" 30
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}
