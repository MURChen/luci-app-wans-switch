#!/bin/sh /etc/rc.common
# wansel-egress init: 开机重建 ip rule / 路由表 / nft set / mark 规则

START=99
STOP=10

start() {
	[ -x /usr/sbin/wansel-egress ] || return 0
	# 等待 fw4 与网络就绪
	local i=0
	while [ $i -lt 30 ]; do
		nft list table inet fw4 >/dev/null 2>&1 && \
		ip -4 route show default dev eth0 >/dev/null 2>&1 && break
		sleep 1
		i=$((i+1))
	done
	sleep 1
	/usr/sbin/wansel-egress apply >/dev/null 2>&1
	logger -t wansel-egress "boot apply done" 2>/dev/null
}

stop() {
	[ -x /usr/sbin/wansel-egress ] || return 0
	/usr/sbin/wansel-egress cleanup >/dev/null 2>&1
}

restart() {
	stop
	start
}
